generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  BEMOR
  SHIFOKOR
  ADMINISTRATOR
}

model User {
  id                    String               @id @default(uuid())
  phone                 String               @unique
  passwordHash          String
  fullName              String
  role                  Role                 @default(BEMOR)
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  patientPrescriptions  Prescription[]       @relation("PatientPrescriptions")
  doctorPrescriptions   Prescription[]       @relation("DoctorPrescriptions")
  medicationSchedules   MedicationSchedule[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

enum DosageForm {
  TABLETKA
  KAPSULA
  SIROP
  INYEKSIYA
  MALHAM
  TOMCHI
  SPREY
  BOSHQA
}

model Drug {
  id                   String     @id @default(uuid())
  name                 String // savdo nomi (masalan "Paracetamol Extra")
  internationalName    String? // INN — xalqaro nomi (masalan "Paracetamol")
  manufacturer         String // ishlab chiqaruvchi
  country              String? // ishlab chiqarilgan mamlakat
  dosageForm           DosageForm @default(BOSHQA) // tabletka, sirop va h.k.
  dosage               String? // masalan "500mg", "5mg/ml"
  packageSize          String? // masalan "20 tabletka/quti"
  barcode              String?    @unique
  price                Decimal    @db.Decimal(12, 2)
  stock                Int        @default(0)
  requiresPrescription Boolean    @default(false)
  description          String?
  imageUrl             String?
  isActive             Boolean    @default(true) // sotuvdan olib tashlangan bo'lsa false (soft delete)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  prescriptionItems    PrescriptionItem[]
  medicationSchedules  MedicationSchedule[]
  interactionsAsA      DrugInteraction[]     @relation("InteractionsAsA")
  interactionsAsB      DrugInteraction[]     @relation("InteractionsAsB")

  @@index([name])
  @@map("drugs")
}

// F-004 (soddalashtirilgan) — real ma'lumot manbai (DrugBank litsenziyasi) hozircha yo'q, shuning
// uchun bu jadval admin tomonidan qo'lda kiritiladi. Juftlik doim drugAId < drugBId tartibida
// saqlanadi (interaction.service.ts'dagi sortPair), A-B va B-A bir xil yozuv hisoblanishi uchun.
enum InteractionSeverity {
  GREEN // minimal
  YELLOW // ehtiyot bo'lish kerak
  RED // xavfli
}

model DrugInteraction {
  id          String              @id @default(uuid())
  drugAId     String
  drugA       Drug                @relation("InteractionsAsA", fields: [drugAId], references: [id], onDelete: Cascade)
  drugBId     String
  drugB       Drug                @relation("InteractionsAsB", fields: [drugBId], references: [id], onDelete: Cascade)
  severity    InteractionSeverity
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([drugAId, drugBId])
  @@index([drugAId])
  @@index([drugBId])
  @@map("drug_interactions")
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PrescriptionSource {
  OCR // aptekachek/qog'oz retsept rasmidan (F-002)
  DMED_QR // dmed davlat tizimidan QR orqali (F-001) — hozircha mock adapter
}

model Prescription {
  id           String              @id @default(uuid())
  patientId    String
  patient      User                @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId     String?
  doctor       User?               @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  source       PrescriptionSource  @default(OCR)
  imageUrl     String? // yuklangan retsept rasmi (/uploads/prescriptions/...) — DMED_QR manbasida yo'q
  dmedUuid     String?             @unique // dmed retsept UUID (faqat DMED_QR manbasida)
  status       PrescriptionStatus  @default(PENDING)
  rejectReason String?
  reviewedAt   DateTime?
  items        PrescriptionItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@map("prescriptions")
}

// Har bir yozuv — ocr-service'ning DMED retsept OCR natijasidagi bitta dori qatoriga mos keladi.
// Maydon nomlari OCR javobidagi (`retseptlar[]`) o'zbekcha kalitlarga bevosita mos keltirilgan —
// OCR'dan kelgan ma'lumot hech qanday yo'qotishsiz saqlanishi uchun.
model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  retseptId      String? // DMED retsept ID (masalan MAB1361987)
  himoyaKodi     String?
  bemorFish      String?
  bemorYosh      String?
  shifokorFish   String? // retseptga qo'lda yozilgan shifokor ismi (User'ga bog'lanmagan, faqat matn)
  drugId         String?
  drug           Drug?        @relation(fields: [drugId], references: [id])
  drugNameRaw    String // OCR: dori_nomi_xpn — bazada mos dori topilmasa ham saqlanadi
  releaseForm    String? // OCR: chiqarilish_shakli
  usageMethod    String? // OCR: qabul_qilish_usuli
  dailyDoseCount String? // OCR: kunlik_qabul_soni
  duration       String? // OCR: davomiyligi
  regimen        String? // OCR: qabul_tartibi
  totalQuantity  String? // OCR: umumiy_miqdori
  note           String? // OCR: izoh
  validUntil     String? // OCR: amal_qilish_muddati
  medicationSchedule MedicationSchedule?

  @@index([prescriptionId])
  @@map("prescription_items")
}

// F-003 Smart eslatma tizimi — dori qabul qilish jadvali (masalan "kuniga 3 marta: 08:00, 14:00, 20:00").
model MedicationSchedule {
  id            String      @id @default(uuid())
  patientId     String
  patient       User        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  drugId        String?
  drug          Drug?       @relation(fields: [drugId], references: [id])
  drugName      String // erkin nom — drugId bog'lanmagan bo'lsa ham eslatma yaratish mumkin
  dosageNote    String? // masalan "1 tabletka"
  scheduleTimes String[] // ["08:00", "14:00", "20:00"] — HH:mm, server lokal vaqti
  startDate     DateTime
  endDate       DateTime? // bo'sh bo'lsa muddatsiz
  isActive      Boolean     @default(true) // false qilinsa yangi dose event yaratilmaydi
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  doseEvents    DoseEvent[]
  prescriptionItemId String?           @unique // tasdiqlangan PrescriptionItem'dan avtomatik yaratilgan bo'lsa (idempotentlik uchun ham kerak)
  prescriptionItem   PrescriptionItem? @relation(fields: [prescriptionItemId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("medication_schedules")
}

enum DoseStatus {
  PENDING
  TAKEN
  SKIPPED
}

// Har bir aniq vaqtdagi bitta doza — "Oldim"/"O'tkazib yubordim" tugmalari shu yozuvga ta'sir qiladi.
model DoseEvent {
  id             String             @id @default(uuid())
  scheduleId     String
  schedule       MedicationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime // shu dozani qabul qilish rejalashtirilgan aniq vaqt
  status         DoseStatus         @default(PENDING)
  confirmedAt    DateTime?
  remindersSent  Int                @default(0) // necha marta "hali ichmadingizmi?" eslatmasi yuborilgani
  lastReminderAt DateTime?
  createdAt      DateTime           @default(now())

  @@unique([scheduleId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("dose_events")
}
