PORT=3001
# Supabase session pooler (5432) ishlatilsa ulanishlarni cheklang, masalan:
#   ...pooler.supabase.com:5432/postgres?connection_limit=3&pool_timeout=20&connect_timeout=15
# sslmode=require qo'shmang — pooler bilan ulanishlar uzilib qolishiga olib keldi.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aptekachi_auth?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/aptekachi_auth?schema=public
JWT_ACCESS_SECRET=change-me-access-secret
NODE_ENV=development
OCR_SERVICE_URL=http://localhost:3000
DMED_MODE=mock
TZ=Asia/Tashkent
CORS_ORIGINS=http://localhost:5173
